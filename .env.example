# ================================================================
# PteroShop — Environment Variables
# Copy: cp .env.example .env  kemudian isi nilainya
# ================================================================

# ── Telegram Bot ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxYZ
BOT_OWNER_ID=123456789

# ── Pakasir Payment Gateway ──────────────────────────────────────
PAKASIR_API_KEY=pk_live_xxxxxxxxxxxxxxxx
PAKASIR_PROJECT=nama-proyek-kamu

# ── Pterodactyl Panel ────────────────────────────────────────────
PTERODACTYL_PANEL_URL=https://panel.domain.com
PTERODACTYL_API_KEY=ptla_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Egg & Node IDs (lihat Admin → Nests di panel) ───────────────
NODEJS_EGG_ID=15
PYTHON_EGG_ID=16
DEFAULT_LOCATION_ID=1
DEFAULT_NODE_ID=1

# ── Database MySQL ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pterobot
DB_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
BOT_DB_NAME=pterobot

# ── Panel Admin Web (berjalan di port 8080) ──────────────────────
ADMIN_PANEL_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI_PASSWORD_PANEL_DISINI
SESSION_SECRET=RANDOM_STRING_PANJANG_DISINI

# ── Domain publik VPS (opsional — untuk callback Pakasir) ────────
# Isi jika kamu punya domain/IP publik
# PUBLIC_DOMAIN=subdomain.domain.com
