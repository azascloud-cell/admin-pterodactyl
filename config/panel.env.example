# ============================================================
# Pterodactyl Panel - Environment Configuration Example
# Copy this to your GitHub Actions secrets or server .env
# ============================================================

# ---- Panel Domain ----
PANEL_FQDN=panel.yourdomain.com

# ---- Admin Account ----
PANEL_EMAIL=admin@yourdomain.com
ADMIN_USER=admin
ADMIN_PASS=YourSecurePassword123!

# ---- Database ----
DB_PASSWORD=YourDBPassword456!

# ---- Timezone ----
# See: https://www.php.net/manual/en/timezones.php
PANEL_TIMEZONE=Asia/Jakarta

# ---- Panel Version ----
# Use "latest" or a specific tag like "v1.11.7"
PANEL_VERSION=latest

# ---- Wings Version ----
# Use "latest" or a specific tag like "v1.11.8"
WINGS_VERSION=latest

# ---- Server SSH (for GitHub Actions deployment) ----
# SSH_HOST=your.server.ip
# SSH_USER=root
# SSH_PORT=22
# SSH_PRIVATE_KEY=<paste your private key>
