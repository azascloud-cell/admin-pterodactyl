modules = ["nodejs-24", "python-base-3.13"]
[userenv]

[userenv.shared]
REPO_GITHUB_PRIVATE = "https://github.com/azascloud-cell/admin-pterodactyl"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PteroShop Bot"

[[workflows.workflow]]
name = "PteroShop Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"

[workflows.workflow.metadata]
outputType = "console"
